+/**
+ * 社区发行版（小胰宝）不出网检查官方更新。
+ *
+ * CHG-000 C-002 / 隐私承诺：社区版不得指向 dshdesktop.com。
+ * 运行时更新检查是硬编码在 update/* 里的（build.publish=[] 只关打包/发布配置，管不住它）：
+ * 实测打包版启动 15–30s 后必发 GET https://dshdesktop.com/... 并提示可升级到官方
+ * DSH Desktop（P-34）。此处把「是否支持更新」一刀关掉，升级通道整体不启用；
+ * CHG-007 接入社区更新源时改这里（或复现一趟支持的检查）。
+ */
+const COMMUNITY_UPDATES_DISABLED = true
+
 function supportsUpdates(): boolean {
+  if (COMMUNITY_UPDATES_DISABLED) return false
   return supportsAutoUpdates(app.isPackaged, process.platform)
 }
 
