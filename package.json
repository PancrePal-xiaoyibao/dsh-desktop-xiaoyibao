  "//": [
    "\u4e3a\u4ec0\u4e48\u8fd9\u91cc\u5fc5\u987b\u6709 package.json\uff1a",
    "1) \u672c\u4ed3\u662f**\u53ea\u542b\u793e\u533a\u7248\u5fc5\u9700\u4ee3\u7801**\u7684\u53d1\u884c\u4ed3\uff0cvendor/ \u4e0e\u5d4c\u5957 node_modules \u5df2\u79fb\u51fa\u7248\u672c\u63a7\u5236\uff1b",
    "   \u4e0a\u6e38\u5ba2\uff08CI \u4e0e\u793e\u533a\u5f00\u53d1\u8005\uff09\u9700\u8981\u4e00\u4efd\u6839\u6e05\u5355\u624d\u80fd npm ci\u3002",
    "2) test/release/public-sync-workflow.test.mjs \u66fe\u4ece vendor/dsh-desktop-main/node_modules",
    "   **\u501f**js-yaml\uff08\u5bc4\u751f\u4f9d\u8d56\uff09\u2014\u2014 \u672c\u5730 vendor \u5728\u573a\u65f6\u7eff\u3001CI \u5e72\u51c0\u68c0\u51fa\u65f6 MODULE_NOT_FOUND\u3002",
    "   \u4f9d\u8d56\u5fc5\u987b\u88ab\u663e\u5f0f\u58f0\u660e\uff0c\u6240\u4ee5 js-yaml \u843d\u5230 devDependencies\u3002",
    "3) \u6545\u610f**\u4e0d\u5199** \"type\"\uff1a\u4fdd\u6301 .js \u4ecd\u6309 CJS \u89e3\u6790\uff08\u4e0e\u65e2\u6709\u4ee3\u7801\u4e00\u81f4\uff0c\u907f\u514d\u6539\u53d8\u8bed\u4e49\uff09\u3002"
  ],
  "devDependencies": {
